{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable3",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "dbo_abonnes",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "window1"
				},
				{
					"name": "select1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nom_table as string,",
				"          valeur_watermark as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          abonne_id as integer,",
				"          nom as string,",
				"          email as string,",
				"          ville as string,",
				"          modifie_le as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source2 window(over(modifie_le,",
				"          abonne_id,",
				"          email,",
				"          ville),",
				"     desc(modifie_le, true),",
				"     row_num = rowNumber()) ~> window1",
				"aggregate1 select(mapColumn(",
				"          modifie_le,",
				"          row_num",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 filter(ERROR_FUNCTION('')) ~> filter1",
				"window1 aggregate(groupBy(modifie_le),",
				"     max_column = max(modifie_le)) ~> aggregate1"
			]
		}
	}
}