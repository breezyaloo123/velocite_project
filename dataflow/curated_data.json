{
	"name": "curated_data",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "raw_abonnee",
						"type": "DatasetReference"
					},
					"name": "rawAbonnee"
				},
				{
					"dataset": {
						"referenceName": "raw_stations",
						"type": "DatasetReference"
					},
					"name": "RawStations"
				},
				{
					"dataset": {
						"referenceName": "raw_locations",
						"type": "DatasetReference"
					},
					"name": "RawLocations"
				},
				{
					"dataset": {
						"referenceName": "curated_locations",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "abonnee_Quanrantaine",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "curated_abonnee",
						"type": "DatasetReference"
					},
					"name": "sink2"
				},
				{
					"dataset": {
						"referenceName": "stations_quanrantaine",
						"type": "DatasetReference"
					},
					"name": "sink3"
				},
				{
					"dataset": {
						"referenceName": "curated_stations",
						"type": "DatasetReference"
					},
					"name": "sink4"
				},
				{
					"dataset": {
						"referenceName": "curated_locations",
						"type": "DatasetReference"
					},
					"name": "sink5"
				},
				{
					"dataset": {
						"referenceName": "locations_quanrantaine",
						"type": "DatasetReference"
					},
					"name": "sink6"
				},
				{
					"dataset": {
						"referenceName": "data_consumption",
						"type": "DatasetReference"
					},
					"name": "sink7"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "split3"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "window2"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          abonne_id as integer,",
				"          nom as string,",
				"          email as string,",
				"          ville as string,",
				"          modifie_le as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> rawAbonnee",
				"source(output(",
				"          station_id as integer,",
				"          nom as string,",
				"          capacite as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> RawStations",
				"source(output(",
				"          location_id as integer,",
				"          abonne_id as integer,",
				"          station_depart as integer,",
				"          station_arrivee as integer,",
				"          debut as timestamp,",
				"          fin as timestamp,",
				"          montant as decimal(6,2),",
				"          modifie_le as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> RawLocations",
				"source(output(",
				"          location_id as integer,",
				"          abonne_id as integer,",
				"          station_depart as integer,",
				"          station_arrivee as integer,",
				"          debut as timestamp,",
				"          fin as timestamp,",
				"          montant as double,",
				"          modifie_le as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> source1",
				"rawAbonnee derive(email = regexReplace(email, '(^[^@]{2})(.*)(@.*$)', '$1***$3')) ~> derivedColumn1",
				"derivedColumn1 window(over(abonne_id),",
				"     desc(modifie_le, true),",
				"     row_num = rowNumber()) ~> window1",
				"window1 filter(row_num == 1) ~> filter1",
				"filter1 select(mapColumn(",
				"          abonne_id,",
				"          nom,",
				"          email,",
				"          ville,",
				"          modifie_le",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 split(!isNull(abonne_id) &&\r",
				"!isNull(nom) &&\r",
				"!isNull(email) &&\r",
				"!isNull(ville) &&\r",
				"!isNull(modifie_le),",
				"     disjoint: true) ~> split1@(DonneesValides, DonneesInvalides)",
				"split1@DonneesInvalides derive(date_rejet = currentDate()) ~> derivedColumn2",
				"RawStations split(!isNull(station_id) &&\r",
				"!isNull(nom) &&\r",
				"!isNull(capacite),",
				"     disjoint: true) ~> split2@(DonneesValide, DonneesInValides)",
				"split2@DonneesInValides derive(date_rejet = currentDate()) ~> derivedColumn3",
				"split2@DonneesValide select(mapColumn(",
				"          station_id,",
				"          nom,",
				"          capacite",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"RawLocations derive(montant = toDouble(montant)) ~> derivedColumn4",
				"select3 split(!isNull(location_id) &&\r",
				"!isNull(abonne_id) &&\r",
				"!isNull(station_depart) &&\r",
				"!isNull(station_arrivee) &&\r",
				"!isNull(debut) &&\r",
				"!isNull(modifie_le) &&\r",
				"(!isNull(fin) && fin >= debut) &&\r",
				"(!isNull(montant) && montant >= 0),",
				"     disjoint: true) ~> split3@(LocationsDonneesValides, LocationsDonneesInvalides)",
				"source1 derive(duree_minutes = toInteger(round((toLong(fin) - toLong(debut)) / 60000)),",
				"          date_jour = toDate(debut)) ~> derivedColumn5",
				"derivedColumn5 aggregate(groupBy(date_jour,",
				"          station_depart,",
				"          station_arrivee),",
				"     nb_trajets = count(location_id),",
				"          duree_total_trajets = sum(duree_minutes),",
				"          duree_total_moyennes = round(avg(duree_minutes), 2),",
				"          montant_total = sum(montant)) ~> aggregate1",
				"derivedColumn4 window(over(location_id),",
				"     desc(modifie_le, true),",
				"     row_num = rowNumber()) ~> window2",
				"window2 filter(row_num == 1) ~> filter2",
				"filter2 select(mapColumn(",
				"          location_id,",
				"          abonne_id,",
				"          station_depart,",
				"          station_arrivee,",
				"          debut,",
				"          fin,",
				"          montant,",
				"          modifie_le",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"split1@DonneesValides sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     partitionFileNames:[(concat('curated_abonnee', '.parquet'))],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink3",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     partitionFileNames:[(concat('curated_stations', '.parquet'))],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink4",
				"split3@LocationsDonneesValides sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          station_id as integer,",
				"          nom as string,",
				"          capacite as integer",
				"     ),",
				"     format: 'parquet',",
				"     partitionFileNames:[(concat('curated_locations', '.parquet'))],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink5",
				"split3@LocationsDonneesInvalides sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          abonne_id as integer,",
				"          nom as string,",
				"          email as string,",
				"          ville as string,",
				"          modifie_le as timestamp,",
				"          date_rejet as date",
				"     ),",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink6",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          abonne_id as integer,",
				"          nom as string,",
				"          email as string,",
				"          ville as string,",
				"          modifie_le as timestamp,",
				"          date_rejet as date",
				"     ),",
				"     format: 'parquet',",
				"     partitionFileNames:[(concat('marketing', '.parquet'))],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink7"
			]
		}
	}
}